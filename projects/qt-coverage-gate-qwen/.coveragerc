[run]
source =
    core
    analytics
    live
    factor_engine
    ml

omit =
    testing/*
    docs/*
    gpu-train/*
    engine/*
    */tests/*
    */__pycache__/*
    setup.py
    conftest.py

[report]
show_missing = true
skip_covered = false
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.
    raise NotImplementedError
    pass
    except ImportError
    except Exception
    if TYPE_CHECKING

[html]
directory = htmlcov
